{
  "name": "portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @portfolio/web --filter @portfolio/api dev",
    "dev:all": "pnpm --parallel --filter @portfolio/web --filter @portfolio/api dev",
    "dev:web": "pnpm --filter @portfolio/web dev",
    "dev:api": "pnpm --filter @portfolio/api dev",
    "build": "pnpm --recursive build",
    "build:web": "pnpm --filter @portfolio/web build",
    "build:api": "pnpm --filter @portfolio/api build",
    "start": "pnpm --filter @portfolio/web start",
    "start:web": "pnpm --filter @portfolio/web start",
    "start:api": "pnpm --filter @portfolio/api start",
    "db:generate": "pnpm --filter @portfolio/db db:generate",
    "db:push": "pnpm --filter @portfolio/db db:push",
    "db:migrate": "pnpm --filter @portfolio/db db:migrate",
    "db:studio": "pnpm --filter @portfolio/db db:studio"
  },
  "packageManager": "pnpm@12.6.0"
}
